# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets. .env.example holds only empty
# placeholders and documents which variables to set in Vercel's dashboard,
# so it's the one exception that should be committed.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw/source video — never deployed, never committed. Drop new raw footage
# here; scripts/organize-media.mjs compresses it into public/media/videos/.
/media-source/

# public/media/incoming/ is legacy — organize-media.mjs now reads from
# /media-source/ instead. Keep this empty except for .gitkeep so nothing
# raw ever accidentally ships if a file is dropped here out of habit.
/public/media/incoming/*
!/public/media/incoming/.gitkeep
