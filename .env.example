# Copy this file to .env.local and fill in the values you have.
# The site runs in demo mode with any of these left blank — see README.md.

# ---------------------------------------------------------------------------
# App URL — the single source of truth for tracking links, notification
# links, canonical/OG metadata, and redirects. REQUIRED in production: with
# this unset, a production deploy falls back to the business's own real
# domain (https://www.txroadsideassistance.com) rather than ever emitting a
# localhost link, but that fallback may not match your actual deploy domain
# (a staging environment, a Vercel preview URL, etc.) — always set this
# explicitly once you know your real deployed domain.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Dispatch destination — where every new customer request is sent
# internally. Always notified, independent of the customer's own SMS
# consent (that setting only controls messages sent TO the customer).
# DISPATCH_PHONE must be E.164 (+1XXXXXXXXXX).
# ---------------------------------------------------------------------------
DISPATCH_EMAIL=info@texasroadside-assistance.com
DISPATCH_PHONE=+19454121215

# ---------------------------------------------------------------------------
# Supabase (database, auth, storage, realtime)
# Required for: admin dashboard, driver portal, live tracking persistence,
# CMS content management, request storage.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Maps / Places / Routes
# Required for: interactive map picker in the request flow, live tracking
# map, address autocomplete, geocoding. Without these the site falls back to
# manual address entry and an abstract route visualization.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY should be restricted by HTTP referrer.
# GOOGLE_MAPS_SERVER_API_KEY (optional) can be a separate, more permissive
# key restricted by IP for server-side geocoding calls.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Google Business Profile place ID, for the real-reviews section on the home
# page. Needs GOOGLE_MAPS_SERVER_API_KEY (the server key, not the NEXT_PUBLIC
# one) with Places API enabled. With either unset the section renders nothing —
# it never shows placeholder or sample reviews.
GOOGLE_PLACE_ID=

# ---------------------------------------------------------------------------
# Twilio (SMS notifications)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Resend (transactional email)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="TRA Dispatch <info@texasroadside-assistance.com>"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional analytics / consent-gated tracking (inactive unless set)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_CONTAINER_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads conversion tracking. The global site tag loads only when the ID is
# set; the conversion on the request confirmation page fires only when BOTH are
# set. The label is the part after the slash in the send_to value Google gives
# you for the conversion action ("AW-XXXXXXXXX/<label>").
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# ---------------------------------------------------------------------------
# Optional spam protection (hCaptcha) — adapter is wired for future use,
# not yet enforced on the request form.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
